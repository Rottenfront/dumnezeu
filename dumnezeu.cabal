cabal-version:      3.12

name:               dumnezeu

version:            0.1.0.0

synopsis:           Odin language subset compiler

license:            BSD-3-Clause

license-file:       LICENSE

author:             Andre Rottenfront

maintainer:         rottenfront@atomicmail.io

category:           Language
build-type:         Custom

extra-doc-files:    CHANGELOG.md, README.md
extra-source-files:
    grammar/Odin.cf
    resources/odin.ebnf
    resources/syntax-overview.md
    flake.nix
    flake.lock
    nix/dev-shell.nix
    shell.nix
    tests/odin/*.odin
    tests/odin/README.md

custom-setup
    setup-depends:
        base ^>=4.20.2.0,
        Cabal >=3.12 && <3.17,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        process >=1.6 && <1.7

common defaults
    ghc-options: -Wall -Wcompat
    default-language: GHC2021

executable dumnezeu
    import: defaults
    hs-source-dirs: app
    main-is: Main.hs
    build-depends:
        base ^>=4.20.2.0,
        dumnezeu

library
    import: defaults
    hs-source-dirs: src, generated
    build-depends:
        base ^>=4.20.2.0,
        array >=0.5 && <0.6,
    exposed-modules:
        Dumnezeu.Odin
        Dumnezeu.Generated.Odin.Abs
    other-modules:
        Dumnezeu.Generated.Odin.Lex
        Dumnezeu.Generated.Odin.Par
        Dumnezeu.Generated.Odin.Print
    autogen-modules:
        Dumnezeu.Generated.Odin.Abs
        Dumnezeu.Generated.Odin.Lex
        Dumnezeu.Generated.Odin.Par
        Dumnezeu.Generated.Odin.Print

test-suite parser-tests
    import: defaults
    type: exitcode-stdio-1.0
    hs-source-dirs: tests/haskell
    main-is: Main.hs
    build-depends:
        base ^>=4.20.2.0,
        directory >=1.3 && <1.4,
        filepath >=1.5 && <1.6,
        dumnezeu
