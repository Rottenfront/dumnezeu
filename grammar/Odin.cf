entrypoints Program, Expr;

PProgram. Program ::= [FileTagDecl] "package" Ident ";" [TopDecl];
DFileTag. FileTagDecl ::= FileTag ";";
terminator FileTagDecl "";
DImport. TopDecl ::= "import" String ";";
DImportNamed. TopDecl ::= "import" Ident String ";";
DValue. TopDecl ::= Decl ";";
terminator TopDecl "";

DInferred. Decl ::= [Expr] ":=" [Expr];
DConstant. Decl ::= [Expr] "::" Expr;
DTyped. Decl ::= [Expr] ":" Type;
DInitialized. Decl ::= [Expr] ":" Type "=" [Expr];
separator nonempty Ident ",";
separator nonempty Expr ",";

TName. Type ::= Ident;
TQualified. Type ::= Ident "." Ident;
TPointer. Type ::= "^" Type;
TMultiPointer. Type ::= "[^]" Type;
TArray. Type ::= "[" Expr "]" Type;
TInferredArray. Type ::= "[" "?" "]" Type;
TSlice. Type ::= "[" "]" Type;
TDynamic. Type ::= "[" "dynamic" "]" Type;
TProc. Type ::= "proc" "(" [Type] ")" Results;
separator Type ",";

PParam. Param ::= [Ident] ":" Type;
PDefault. Param ::= [Ident] ":" Type "=" Expr;
PVariadic. Param ::= [Ident] ":" ".." Type;
separator Param ",";
RNone. Results ::= ;
ROne. Results ::= "->" Type;
RNamed. Results ::= "->" "(" [Param] ")";

FField. Field ::= [Ident] ":" Type ",";
terminator Field "";
VEnum. EnumValue ::= Ident ",";
VEnumAssigned. EnumValue ::= Ident "=" Expr ",";
terminator EnumValue "";

BBlock. Block ::= "{" [Stmt] "}";
SDecl. Stmt ::= Decl ";";
SExpression. Stmt ::= Expr ";";
SAssign. Stmt ::= [Expr] AssignOp [Expr] ";";
SReturn. Stmt ::= "return" [ReturnExpr] ";";
SIf. Stmt ::= "if" Expr Block ElsePart ";";
SIfInit. Stmt ::= "if" Simple ";" Expr Block ElsePart ";";
SFor. Stmt ::= "for" Block ";";
SWhile. Stmt ::= "for" Expr Block ";";
SForRange. Stmt ::= "for" [Expr] "in" Expr Block ";";
SForC. Stmt ::= "for" Simple ";" Expr ";" Simple Block ";";
SLabelledRange. Stmt ::= [Expr] ":" "for" [Expr] "in" Expr Block ";";
SSwitch. Stmt ::= "switch" Expr "{" [Case] "}" ";";
SDefer. Stmt ::= "defer" Stmt;
SBreak. Stmt ::= "break" ";";
SBreakLabel. Stmt ::= "break" Ident ";";
SContinue. Stmt ::= "continue" ";";
SContinueLabel. Stmt ::= "continue" Ident ";";
terminator Stmt "";
ENone. ElsePart ::= ;
EElse. ElsePart ::= "else" Block;
EElseIf. ElsePart ::= "else" "if" Expr Block ElsePart;
CSwitch. Case ::= "case" [ReturnExpr] ":" [Stmt];
terminator Case "";
RetExpr. ReturnExpr ::= Expr;
separator ReturnExpr ",";
SimpleDecl. Simple ::= Decl;
SimpleAssign. Simple ::= [Expr] AssignOp [Expr];
SimpleExpr. Simple ::= Expr;

ASet. AssignOp ::= "=";
AAdd. AssignOp ::= "+=";
ASub. AssignOp ::= "-=";
AMul. AssignOp ::= "*=";
ADiv. AssignOp ::= "/=";
ARem. AssignOp ::= "%=";
AMod. AssignOp ::= "%%=";
AOr. AssignOp ::= "|=";
AXor. AssignOp ::= "~=";
AAnd. AssignOp ::= "&=";
AAndNot. AssignOp ::= "&~=";
AShl. AssignOp ::= "<<=";
AShr. AssignOp ::= ">>=";
ALogicalAnd. AssignOp ::= "&&=";
ALogicalOr. AssignOp ::= "||=";

ERangeExclusive. Expr ::= Expr1 "..<" Expr1;
ERangeInclusive. Expr ::= Expr1 "..=" Expr1;
EOr. Expr1 ::= Expr1 "||" Expr2;
EAnd. Expr2 ::= Expr2 "&&" Expr3;
EEqual. Expr3 ::= Expr3 "==" Expr4;
ENotEqual. Expr3 ::= Expr3 "!=" Expr4;
ELess. Expr3 ::= Expr3 "<" Expr4;
ELessEqual. Expr3 ::= Expr3 "<=" Expr4;
EGreater. Expr3 ::= Expr3 ">" Expr4;
EGreaterEqual. Expr3 ::= Expr3 ">=" Expr4;
EAdd. Expr4 ::= Expr4 "+" Expr5;
ESub. Expr4 ::= Expr4 "-" Expr5;
EBitOr. Expr4 ::= Expr4 "|" Expr5;
EBitXor. Expr4 ::= Expr4 "~" Expr5;
EMul. Expr5 ::= Expr5 "*" Expr6;
EDiv. Expr5 ::= Expr5 "/" Expr6;
ERem. Expr5 ::= Expr5 "%" Expr6;
EMod. Expr5 ::= Expr5 "%%" Expr6;
EBitAnd. Expr5 ::= Expr5 "&" Expr6;
EBitAndNot. Expr5 ::= Expr5 "&~" Expr6;
EShl. Expr5 ::= Expr5 "<<" Expr6;
EShr. Expr5 ::= Expr5 ">>" Expr6;
EPositive. Expr6 ::= "+" Expr6;
ENegative. Expr6 ::= "-" Expr6;
ENot. Expr6 ::= "!" Expr6;
EComplement. Expr6 ::= "~" Expr6;
EAddress. Expr6 ::= "&" Expr6;
ECast. Expr6 ::= "cast" "(" Type ")" Expr6;
ECall. Expr7 ::= Expr7 "(" [Arg] ")";
EField. Expr7 ::= Expr7 "." Ident;
EIndex. Expr7 ::= Expr7 "[" Expr "]";
ESlice. Expr7 ::= Expr7 "[" Bound ":" Bound "]";
EDeref. Expr7 ::= Expr7 "^";
EName. Expr8 ::= Ident;
EDiscard. Expr8 ::= "_";
EMake. Expr8 ::= "make" "(" Type ")";
EMakeSized. Expr8 ::= "make" "(" Type "," [Expr] ")";
EContext. Expr8 ::= "context";
EInteger. Expr8 ::= IntegerLiteral;
EFloat. Expr8 ::= Double;
EString. Expr8 ::= String;
EChar. Expr8 ::= Char;
ETrue. Expr8 ::= "true";
EFalse. Expr8 ::= "false";
ENil. Expr8 ::= "nil";
EImplicit. Expr8 ::= "." Ident;
EUninitialized. Expr8 ::= "---";
EProcedure. Expr8 ::= "proc" "(" [Param] ")" Results Block;
EStruct. Expr8 ::= "struct" "{" [Field] "}";
EEnum. Expr8 ::= "enum" "{" [EnumValue] "}";
ECompound. Expr8 ::= Ident "@{" [Element] "}";
EArrayLiteral. Expr8 ::= "[" Expr "]" Type "@{" [Element] "}";
EInferredLiteral. Expr8 ::= "[" "?" "]" Type "@{" [Element] "}";
ESliceLiteral. Expr8 ::= "[" "]" Type "@{" [Element] "}";
EDynamicLiteral. Expr8 ::= "[" "dynamic" "]" Type "@{" [Element] "}";
EUntypedLiteral. Expr8 ::= "@{" [Element] "}";
coercions Expr 8;
BoundNone. Bound ::= ;
BoundSome. Bound ::= Expr;
ArgValue. Arg ::= Expr;
ArgNamed. Arg ::= Ident "=" Expr;
ArgSpread. Arg ::= ".." Expr;
separator Arg ",";
ElementValue. Element ::= Expr;
ElementNamed. Element ::= Ident "=" Expr;
separator Element ",";

token IntegerLiteral (digit+ | '0' 'x' (digit | ["abcdefABCDEF"])+ | '0' 'b' ["01"]+ | '0' 'o' ["01234567"]+);
token FileTag ('#' '+' (char - ["\n\r"])*);
comment "//";
comment "/*" "*/";
